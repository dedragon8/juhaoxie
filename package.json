{
  "name": "changjing-screenwriter",
  "version": "0.6.16",
  "private": true,
  "type": "module",
  "description": "剧好写 · 中文剧本写作",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader native",
    "server": "tsx server/index.ts",
    "build": "node scripts/build-prompt-skill.mjs && tsc --noEmit && vite build --configLoader native",
    "desktop": "electron .",
    "package:mac": "pnpm build && node scripts/package-mac.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "preview": "node scripts/preview.mjs",
    "build:native-shell": "node scripts/build-native-shell.mjs",
    "build:icloud": "node scripts/build-icloud.mjs",
    "sign:icloud": "node scripts/sign-icloud.mjs"
  },
  "dependencies": {
    "@hocuspocus/provider": "^3.4.0",
    "@hocuspocus/server": "^3.4.0",
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-collaboration": "^3.0.0",
    "@tiptap/extension-collaboration-caret": "^3.0.0",
    "@tiptap/extension-document": "^3.0.0",
    "@tiptap/extension-hard-break": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-text": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/y-tiptap": "^3.0.0",
    "fractional-indexing": "^3.2.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "1.0.7",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@playwright/test": "^1.51.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^38.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  },
  "packageManager": "pnpm@11.25.0",
  "author": "付俊皓 (Fu Junhao)",
  "license": "GPL-3.0-only"
}
